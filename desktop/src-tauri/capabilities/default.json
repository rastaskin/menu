{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно: релей синхронизации, вход в Google, Sheets API, ключ семьи в Google Диске (appDataFolder), обновления",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://sheets.googleapis.com/*" },
        { "url": "https://www.googleapis.com/drive/*" },
        { "url": "https://www.googleapis.com/upload/drive/*" },
        { "url": "https://menu-relay.menu-relay.workers.dev/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://accounts.google.com/*" },
        { "url": "https://docs.google.com/*" }
      ]
    }
  ]
}
